# Apache 2.4+ (Hostinger)
# Bloqueia todos os PHP por padrão e libera apenas os endpoints públicos

# Negar tudo por padrão
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# Libera apenas os endpoints de API necessários
<FilesMatch "^(createPix|checkPix|processCardPayment)\.php$">
    Require all granted
</FilesMatch>
